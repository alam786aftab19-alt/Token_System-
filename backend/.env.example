# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5000

# Supabase Credentials
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# JWT Token Secret
JWT_SECRET=your_jwt_signing_secret_key_here

# EmailJS Configuration (Optional for dev, console prints verification link if empty)
# Get these from your EmailJS Dashboard
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
